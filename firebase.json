{
  "hosting": [
    {
      "target": "watchfloor",
      "public": "web",
      "ignore": ["**/.*"],
      "headers": [
        {"source": "**/*.@(html|js|css|json)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
        {"source": "**", "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
          {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://mc-api-odg3xhcd4a-uc.a.run.app; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"}
        ]}
      ]
    }
  ]
}
